# LOCAL DEVELOPMENT ONLY
# Copy this file to a new file named .env. Never commit the .env file.

# REQUIRED: Create this in Alibaba Cloud Model Studio, in the Singapore region.
# Example shape only: sk-xxxxxxxx. Do not include quotes.
QWEN_API_KEY=

# These defaults work with a Singapore Model Studio API key.
# Change the base URL only if your API key was created in another region or
# you choose to use the workspace-specific URL shown by Model Studio.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-flash
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TIMEOUT_SECONDS=90

# OPTIONAL: Used only to add Google Images to Qwen-generated meal plans.
# Subscribe to CognifyAPI's Google Images API through RapidAPI and paste the
# RapidAPI application key here. Never put this key in the iOS app.
COGNIFY_API_KEY=
COGNIFY_BASE_URL=https://google-images4.p.rapidapi.com
COGNIFY_API_HOST=google-images4.p.rapidapi.com
COGNIFY_TIMEOUT_SECONDS=12
COGNIFY_CANDIDATE_COUNT=12

# OPTIONAL during initial setup. When set, the iOS app must send the same
# value in its X-Pinchmeal-API-Token header.
API_AUTH_TOKEN=

# Normal application settings. You normally do not need to change these.
ENVIRONMENT=development
LOG_LEVEL=INFO
EXPOSE_DOCS=true
REQUEST_TIMEOUT_SECONDS=25
MAXIMUM_REDIRECTS=4
MAXIMUM_RESPONSE_BYTES=2000000
MAXIMUM_UPLOAD_BYTES=8000000
MINIMUM_SOURCE_TEXT_CHARS=80
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
