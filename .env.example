# LOCAL DEVELOPMENT ONLY
# Copy this file to a new file named .env. Never commit the .env file.

# REQUIRED: Create this key in Google AI Studio. Do not include quotes.
GEMINI_API_KEY=

# Stable, cost-conscious defaults for text and image recipe extraction.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90

# OPTIONAL: Adds Google Images candidates to generated meal plans.
COGNIFY_API_KEY=
COGNIFY_BASE_URL=https://google-images4.p.rapidapi.com
COGNIFY_API_HOST=google-images4.p.rapidapi.com
COGNIFY_TIMEOUT_SECONDS=12
COGNIFY_CANDIDATE_COUNT=12

# OPTIONAL during initial setup. When set, the iOS app must send the same
# value in its X-Pinchmeal-API-Token header.
API_AUTH_TOKEN=

ENVIRONMENT=development
LOG_LEVEL=INFO
EXPOSE_DOCS=true
REQUEST_TIMEOUT_SECONDS=25
MAXIMUM_REDIRECTS=4
MAXIMUM_RESPONSE_BYTES=2000000
MAXIMUM_UPLOAD_BYTES=8000000
MINIMUM_SOURCE_TEXT_CHARS=80
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
